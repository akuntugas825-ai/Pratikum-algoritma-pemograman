#include <iostream>
#include <string>
using namespace std;

int main() {
    string nama;
    float keaktifan, tugas, ujian;
    float murni_keaktifan, murni_tugas, murni_ujian, nilai_akhir;

    cout << "PROGRAM MENGHITUNG NILAI AKHIR SISWA\n";
    cout << "====================================\n";
    cout << "Nama Siswa      : ";
    getline(cin, nama);
    cout << "Nilai Keaktifan : ";
    cin >> keaktifan;
    cout << "Nilai Tugas     : ";
    cin >> tugas;
    cout << "Nilai Ujian     : ";
    cin >> ujian;

    // Perhitungan nilai murni dan nilai akhir
    murni_keaktifan = keaktifan * 0.20;
    murni_tugas = tugas * 0.30;
    murni_ujian = ujian * 0.50;
    nilai_akhir = murni_keaktifan + murni_tugas + murni_ujian;

    cout << "\n---------- HASIL KELUARAN ----------\n";
    cout << "Nama siswa          : " << nama << endl;
    cout << "Nilai keaktifan 20% : " << murni_keaktifan << endl;
    cout << "Nilai tugas 30%     : " << murni_tugas << endl;
    cout << "Nilai ujian 50%     : " << murni_ujian << endl;
    cout << "Nilai akhir         : " << nilai_akhir << endl;

    return 0;
}
