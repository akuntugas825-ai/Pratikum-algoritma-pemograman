#include <iostream>
#include <string>
using namespace std;

int main() {
    string npm, nama;
    float tugas1, tugas2, tugas3, rata;

    cout << "PROGRAM MENGHITUNG NILAI RATA-RATA TUGAS\n";
    cout << "========================================\n";
    cout << "Masukkan NPM       : ";
    cin >> npm;
    cin.ignore(); // Membersihkan buffer enter sebelum getline
    cout << "Masukkan Nama      : ";
    getline(cin, nama);
    cout << "Nilai Tugas I      : ";
    cin >> tugas1;
    cout << "Nilai Tugas II     : ";
    cin >> tugas2;
    cout << "Nilai Tugas III    : ";
    cin >> tugas3;

    // Menghitung rata-rata
    rata = (tugas1 + tugas2 + tugas3) / 3;

    cout << "\n----------------------------------------\n";
    cout << "NPM " << npm << ", siswa bernama " << nama 
         << " memperoleh nilai rata-rata " << rata 
         << " dari hasil tugas yang diikutinya.\n";

    return 0;
}
